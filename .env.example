# ── CONFIGURAÇÕES DO DOCKER COMPOSE ────────────────────────────
# Copie este arquivo para .env na raiz do projeto para configurar
# o ambiente do Docker Compose.

# ── PostgreSQL (Credenciais internas do container) ──────────────
POSTGRES_USER=samuel
POSTGRES_PASSWORD=teste123
POSTGRES_DB=fintrack

# ── RabbitMQ (Credenciais internas do container) ────────────────
RABBITMQ_DEFAULT_USER=samuel
RABBITMQ_DEFAULT_PASS=teste123

# ── URLs dos Serviços (Internos da rede do Docker) ──────────────
PORT=3000
DATABASE_URL=postgres://samuel:teste123@postgres:5432/fintrack
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://samuel:teste123@rabbitmq:5672

# ── Segurança e Autenticação (Backend no Docker) ────────────────
JWT_SECRET=change-me-to-a-32-character-minimum-secret
JWT_EXPIRES_IN=24h
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
