# ── CONFIGURAÇÕES DA APLICAÇÃO ────────
# Este arquivo é lido EXCLUSIVAMENTE pelo docker compose para inter-
# polação de variáveis nos serviços. NUNCA é usado por processos,
# Node na máquina do dev (para isso use backend/.env).
#
# Escopo por camada (evita conflito com os .env internos):
#   1. Infra     — credenciais que CRIAM os containers (postgres, rabbit)
#   2. App       — compartilhado por api e worker (URLs internas da rede Docker)
#   3. API       — específico do serviço api
#   4. Worker    — hoje herda tudo da camada App (var específicas no futuro)
#   5. Frontend  — específico do serviço frontend
#
# Atenção: hosts como postgres/redis/rabbitmq só resolvem DENTRO da
# rede do compose. Para rodar fora do Docker, use localhost no .env do
# respectivo app (backend/.env).

# ── 1. Infraestrutura (credenciais internas dos containers) ────
POSTGRES_USER=samuel
POSTGRES_PASSWORD=teste123
POSTGRES_DB=fintrack

RABBITMQ_DEFAULT_USER=samuel
RABBITMQ_DEFAULT_PASS=teste123

# ── 2. App — compartilhado por api e worker ────────────────────
DATABASE_URL=postgres://samuel:teste123@postgres:5432/fintrack
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://samuel:teste123@rabbitmq:5672
LOG_LEVEL=info
OTEL_COLLECTOR_HOST=otel-collector
JWT_SECRET=change-me-to-a-32-character-minimum-secret

# ── 3. API — específico do serviço api ─────────────────────────
PORT=3000
JWT_EXPIRES_IN=24h
ALLOWED_ORIGINS=http://localhost:5173

# ── 4. Worker — hoje herdado da camada App; sem vars próprias ──
# (ex.: WORKER_CONCURRENCY quando o worker tiver consumer dedicado)

# ── 5. Frontend — específico do serviço frontend ───────────────
# VITE_API_URL=http://localhost:3000
