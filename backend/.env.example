# ── CONFIGURAÇÕES DO BACKEND (DESENVOLVIMENTO LOCAL) ───────────
# Copie este arquivo para .env na pasta backend/ para rodar o
# backend localmente (fora do Docker) via npm run dev.

# ── URLs dos Serviços (Apontando para localhost) ───────────────
DATABASE_URL=postgres://samuel:teste123@localhost:5432/fintrack
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://samuel:teste123@localhost:5672

# ── Configurações do Servidor e Segurança ───────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-32-character-minimum-secret
JWT_EXPIRES_IN=24h
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
