{
  "name": "@fintrack/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist",
    "dev": "tsx watch src/server.ts",
    "db:generate": "dotenv --env-file .env -- drizzle-kit generate",
    "db:migrate": "dotenv --env-file .env -- drizzle-kit migrate",
    "db:studio": "dotenv --env-file .env -- drizzle-kit studio",
    "db:reset": "tsx src/shared/db/reset.ts",
    "db:seed": "tsx src/shared/db/seed.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern='\\.unit\\.test\\.ts$'",
    "test:int": "npx dotenv -e .env.test -- drizzle-kit migrate && jest --testPathPattern='\\.int\\.test\\.ts$'",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.11.1",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
